	--------------------------------------------------
	-- MOBILE / SMALL SCREEN SCALE
	--------------------------------------------------

	local UIScale = Create("UIScale", {
		Scale = 1,
	}, Main)

	local function UpdateScale()
		local Camera =
			workspace.CurrentCamera

		if not Camera then
			return
		end

		local Viewport =
			Camera.ViewportSize

		local ScaleX =
			Viewport.X
			/ (Window.Size.X + 30)

		local ScaleY =
			Viewport.Y
			/ (Window.Size.Y + 30)

		UIScale.Scale = Clamp(
			math.min(
				ScaleX,
				ScaleY,
				1
			),
			0.55,
			1
		)
	end

	UpdateScale()

	if workspace.CurrentCamera then
		table.insert(
			Window.Connections,

			workspace.CurrentCamera
				:GetPropertyChangedSignal(
					"ViewportSize"
				)
				:Connect(
					UpdateScale
				)
		)
	end

