		--------------------------------------------------
		-- SELECT TAB
		--------------------------------------------------

		function Tab:Select()
			for _, OtherTab
				in ipairs(
					self.Window.Tabs
				)
			do
				local Active =
					OtherTab == self

				OtherTab.Page.Visible =
					Active

				OtherTab.Button.TextColor3 =
					Active
						and UILibrary.Theme.Text
						or UILibrary.Theme.SubText

				Tween(
					OtherTab.Button,
					0.1,
					{
						BackgroundColor3 =
							Active
								and UILibrary.Theme.ButtonHover
								or UILibrary.Theme.Background3,
					}
				)
			end

			self.Window.ActiveTab =
				self
		end

		TabButton.MouseButton1Click:Connect(
			function()
				Tab:Select()
			end
		)

