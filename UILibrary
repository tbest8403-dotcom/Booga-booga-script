								SetOpen(
									false
								)
							end
						)
					end
				end

				function Controller:Set(Value, FireCallback)
					Current =
						Value

					UpdateText()

					if FireCallback ~= false then
						SafeCallback(
							Options.Callback,
							Current
						)
					end
				end

				function Controller:Get()
					return Current
				end

				function Controller:SetValues(NewValues)
					Values =
						NewValues or {}

					Rebuild()

					if Open then
						SetOpen(false)
						SetOpen(true)
					end
				end

				function Controller:GetValues()
					return Values
				end

				function Controller:Open()
					SetOpen(true)
				end

				function Controller:Close()
					SetOpen(false)
				end

				Selection.MouseButton1Click:Connect(
					function()
						SetOpen(
							not Open
						)
					end
				)

				Rebuild()
				UpdateText()

				Controller.Instance =
					Control

				return Controller
			end

			--------------------------------------------------
			-- TARGET SELECTOR
			--------------------------------------------------

			function Section:AddTargetSelector(Options)
				Options =
					Options or {}

				local IncludeLocalPlayer =
					Options.IncludeLocalPlayer
					== true

				local function GetPlayers()
					local Names = {}

					for _, Player
						in ipairs(
							Players:GetPlayers()
						)
					do
						if
							IncludeLocalPlayer
							or Player
								~= LocalPlayer
						then
							table.insert(
								Names,
								Player.Name
							)
						end
					end

					table.sort(
						Names,
						function(A, B)
							return A:lower()
								< B:lower()
						end
					)

					return Names
				end

				local Dropdown =
					self:AddDropdown({
						Name =
							Options.Name
							or "Target",

						Placeholder =
							Options.Placeholder
							or "Select target",

						Values =
							GetPlayers(),

						Callback =
							function(Name)
								local Player =
									Players:FindFirstChild(
										tostring(Name)
									)

								SafeCallback(
									Options.Callback,
									Player
								)
							end,
					})

				local Controller = {}

				function Controller:Refresh()
					Dropdown:SetValues(
						GetPlayers()
					)
				end

				function Controller:Get()
					local Name =
						Dropdown:Get()

					if not Name then
						return nil
					end

					return Players:FindFirstChild(
						tostring(Name)
					)
				end

				function Controller:Set(PlayerOrName)
					if PlayerOrName == nil then
						Dropdown:Set(
							nil,
							false
						)

						return
					end

					local Name

					if typeof(PlayerOrName)
						== "Instance"
					then
						Name =
							PlayerOrName.Name
					else
						Name =
							tostring(
								PlayerOrName
							)
					end

					Dropdown:Set(
						Name
					)
				end

				Players.PlayerAdded:Connect(
					function()
						Controller:Refresh()
					end
				)

				Players.PlayerRemoving:Connect(
					function(Player)
						if Dropdown:Get()
							== Player.Name
						then
							Dropdown:Set(
								nil,
								false
							)
						end

						Controller:Refresh()
					end
				)

				Controller.Dropdown =
					Dropdown

				return Controller
			end

