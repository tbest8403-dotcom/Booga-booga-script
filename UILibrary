function UILibrary:RegisterWidget(Name, Constructor)
	assert(
		type(Name) == "string",
		"Widget name must be a string"
	)

	assert(
		type(Constructor) == "function",
		"Widget constructor must be a function"
	)

	self.CustomWidgets[Name] = Constructor
end

