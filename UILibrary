					)

				AddCorner(
					Row,
					7
				)

				Create("TextLabel", {
					Size =
						UDim2.new(
							1,
							-80,
							0,
							28
						),

					Position =
						UDim2.fromOffset(
							10,
							2
						),

					BackgroundTransparency = 1,

					Text =
						tostring(
							Options.Name
							or "Slider"
						),

					TextColor3 =
						UILibrary.Theme.Text,

					TextSize = 12,

					Font =
						Enum.Font.Gotham,

					TextXAlignment =
						Enum.TextXAlignment.Left,
				}, Row)

				local ValueLabel =
					Create(
						"TextLabel",
						{
							Size =
								UDim2.fromOffset(
									65,
									28
								),

							Position =
								UDim2.new(
									1,
									-75,
									0,
									2
								),

							BackgroundTransparency = 1,

							Text = "",

							TextColor3 =
								UILibrary.Theme.SubText,

							TextSize = 11,

							Font =
								Enum.Font.GothamBold,

							TextXAlignment =
								Enum.TextXAlignment.Right,
						},
						Row
					)

				local Track =
					Create(
						"Frame",
						{
							Size =
								UDim2.new(
									1,
									-20,
									0,
									8
								),

							Position =
								UDim2.fromOffset(
									10,
									42
								),

							BackgroundColor3 =
								UILibrary.Theme.Button,

							BorderSizePixel = 0,

							Active = true,
						},
						Row
					)

				AddCorner(
					Track,
					4
				)

				local Fill =
					Create(
						"Frame",
						{
							Size =
								UDim2.fromScale(
									0,
									1
								),

							BackgroundColor3 =
								UILibrary.Theme.Accent,

							BorderSizePixel = 0,
						},
						Track
					)

				AddCorner(
					Fill,
					4
				)

				local SliderDragging =
					false

				local Controller = {}

				local function UpdateVisual()
					local Alpha = 0

					if Maximum ~= Minimum then
						Alpha =
							(Value - Minimum)
							/ (Maximum - Minimum)
					end

					Fill.Size =
						UDim2.fromScale(
							Clamp(
								Alpha,
								0,
								1
							),
							1
						)

					ValueLabel.Text =
						FormatNumber(
							Value
						)
				end

				function Controller:Set(NewValue, FireCallback)
					NewValue =
						tonumber(NewValue)
						or Minimum

					NewValue =
						Clamp(
							NewValue,
							Minimum,
							Maximum
						)

					NewValue =
						RoundToIncrement(
							NewValue,
							Increment
						)

					Value =
						NewValue

					UpdateVisual()

					if FireCallback ~= false then
						SafeCallback(
							Options.Callback,
							Value
						)
					end
				end

				function Controller:Get()
					return Value
				end

				local function UpdateFromInput(Input)
					if Track.AbsoluteSize.X <= 0 then
						return
					end

					local Alpha =
						(
							Input.Position.X
							- Track.AbsolutePosition.X
						)
						/ Track.AbsoluteSize.X

					Alpha =
						Clamp(
							Alpha,
							0,
							1
						)

					Controller:Set(
						Minimum
						+ (
							(Maximum - Minimum)
							* Alpha
						)
					)
				end

				Track.InputBegan:Connect(
					function(Input)
						if
							Input.UserInputType
								== Enum.UserInputType.MouseButton1
							or Input.UserInputType
								== Enum.UserInputType.Touch
						then
							SliderDragging =
								true

							UpdateFromInput(
								Input
							)
						end
					end
				)

				UserInputService.InputChanged:Connect(
					function(Input)
						if not SliderDragging then
							return
						end

						if
							Input.UserInputType
								== Enum.UserInputType.MouseMovement
							or Input.UserInputType
								== Enum.UserInputType.Touch
						then
							UpdateFromInput(
								Input
							)
						end
					end
				)

				UserInputService.InputEnded:Connect(
					function(Input)
						if
							Input.UserInputType
								== Enum.UserInputType.MouseButton1
							or Input.UserInputType
								== Enum.UserInputType.Touch
						then
							SliderDragging =
								false
						end
					end
				)

				UpdateVisual()

				if Options.FireOnLoad then
					SafeCallback(
						Options.Callback,
						Value
					)
				end

				Controller.Instance =
					Row

				return Controller
			end

